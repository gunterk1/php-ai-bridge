# Provider selects where the models run. The application code is identical for
# both; only these variables change.

# --- External (OpenAI) ---
AI_PROVIDER=openai
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
CHAT_MODEL=gpt-4o-mini
EMBED_MODEL=text-embedding-3-small

# --- Local / self-hosted (LocalAI, Ollama, vLLM — any OpenAI-compatible server) ---
# Nothing leaves your infrastructure. Uncomment and adjust:
# AI_PROVIDER=local
# OPENAI_API_KEY=not-needed
# OPENAI_BASE_URL=http://host.docker.internal:11434/v1
# CHAT_MODEL=llama3.2
# EMBED_MODEL=nomic-embed-text
