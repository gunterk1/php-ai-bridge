{
    "name": "gunterk1/php-ai-bridge-symfony",
    "type": "project",
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "symfony/browser-kit": "^8.1",
        "symfony/css-selector": "^8.1"
    },
    "require": {
        "doctrine/doctrine-bundle": "^3.3",
        "doctrine/orm": "^3.6",
        "symfony/console": "^8.1",
        "symfony/dotenv": "^8.1",
        "symfony/framework-bundle": "^8.1",
        "symfony/http-client": "^8.1",
        "symfony/runtime": "^8.1",
        "symfony/security-bundle": "^8.1",
        "symfony/yaml": "^8.1"
    },
    "config": {
        "allow-plugins": {
            "symfony/runtime": true
        },
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
