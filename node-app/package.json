{
  "name": "node-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TypeScript counterpart to php-app: same REST boundary, same retry semantics, different ecosystem.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "tsc && node --test dist/*.test.js"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
